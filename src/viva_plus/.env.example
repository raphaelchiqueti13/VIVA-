NODE_ENV=development
PORT=3001
# Gere um segredo aleatório com pelo menos 32 caracteres antes de publicar.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
# Em hospedagem com disco persistente, use um caminho como /var/data/viva.sqlite.
DATABASE_PATH=./database/viva.sqlite
# Opcional: origens adicionais, separadas por vírgula, para frontend em outro domínio.
CORS_ORIGINS=
# Opcional se frontend e API estiverem em domínios separados.
VITE_API_URL=/api
